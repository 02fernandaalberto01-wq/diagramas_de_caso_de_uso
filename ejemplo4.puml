@startuml

class Cliente {
  - nombre: String
  - direccion: String
  - telefono: String
  - pinTarjeta: String
  - edad: Double
  - idInterno: int
  + registrarDatos(): void
  + solicitarReserva(): void
}

class Reserva {
  - idReserva: int
  - estado: String
  - fecha: Date
  + calcularPrecio(): double
  + confirmarReserva(): boolean
}

class ClientePreferencial {
  - descuentoPreferencial: double
}

class ClienteCorporativo {
  - volumenReservas: int
  + calcularDescuentoCorporativo(): double
}

class Agenda {
  - localidadesLibres: int
  + comprobarDisponibilidad(): boolean
}

' Herencia
Cliente <|-- ClientePreferencial
Cliente <|-- ClienteCorporativo

' Agregación entre Cliente y Reserva ("*" en Reserva)
Cliente "1" o-- "*" Reserva

' Asociación entre Reserva y Agenda (1 a 1)
Reserva "1" -- "1" Agenda

@enduml